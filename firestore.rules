rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the caller is an authenticated admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches(".*@laxmierp[.]com$")
      );
    }

    // Inquiries Collection:
    // Any prospective institute owner can submit an inquiry with validation.
    // Only authenticated admins can read or modify.
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.fullName.size() > 2
                    && request.resource.data.instituteName is string
                    && request.resource.data.mobileNumber is string
                    && request.resource.data.mobileNumber.size() >= 10
                    && request.resource.data.message is string
                    && request.resource.data.consent == true;
      allow read, update, delete: if isAdmin();
    }

    // Demo Requests Collection:
    match /demoRequests/{demoId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.instituteName is string
                    && request.resource.data.phoneNumber is string
                    && request.resource.data.phoneNumber.size() >= 10;
      allow read, update, delete: if isAdmin();
    }

    // Reviews Collection:
    // Public can only read reviews that have status == 'approved'
    // Public can submit a review with status == 'pending'
    // Admins can read all and update/approve/reject/delete
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.instituteName is string
                    && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
                    && request.resource.data.reviewText is string
                    && request.resource.data.status == 'pending'
                    && request.resource.data.consent == true;
      allow update, delete: if isAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
